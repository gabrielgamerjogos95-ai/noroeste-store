<%- include('partials/header', { title: 'Painel Admin' }) %>
<section class="admin-shell">
  <aside class="admin-nav"><h2>Admin</h2><a href="#dashboard">📊 Dashboard</a><a href="#pedidos">📦 Pedidos</a><a href="#produtos">💎 Produtos</a><a href="#configuracoes">⚙️ Configurações</a><form method="post" action="/admin/logout"><button>Sair</button></form></aside>
  <div class="admin-content">
    <section id="dashboard"><div class="section-head"><div><span class="eyebrow">VISÃO GERAL</span><h1>Dashboard</h1></div></div><div class="stats"><div><span>Faturamento aprovado</span><b>R$ <%= paidRevenue.toFixed(2).replace('.', ',') %></b></div><div><span>Pedidos</span><b><%= data.orders.length %></b></div><div><span>Pagos</span><b><%= data.orders.filter(o=>o.status==='paid').length %></b></div><div><span>Produtos ativos</span><b><%= data.products.filter(p=>p.active).length %></b></div></div></section>

    <section id="pedidos" class="admin-section"><h2>Pedidos</h2><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Total</th><th>Pagamento</th><th>Status</th><th>Ação</th></tr></thead><tbody><% data.orders.forEach(o => { %><tr><td><b><%= o.id %></b><small><%= new Date(o.createdAt).toLocaleString('pt-BR') %></small></td><td><%= o.customer.name %><small><%= o.customer.discord || o.customer.email %></small></td><td>R$ <%= o.total.toFixed(2).replace('.', ',') %></td><td><%= o.paymentStatus %><small><%= o.paymentMethod || '' %></small></td><td><span class="status-chip"><%= o.status %></span></td><td><form class="inline-form" method="post" action="/admin/orders/<%= o.id %>/status"><select name="status"><option>paid</option><option>delivered</option><option>pending</option><option>manual_review</option><option>cancelled</option></select><button>Salvar</button></form></td></tr><% }) %><% if(!data.orders.length){ %><tr><td colspan="6">Nenhum pedido ainda.</td></tr><% } %></tbody></table></div></section>

    <section id="produtos" class="admin-section"><div class="section-head"><div><h2>Produtos</h2><p>Cadastre VIPs, carros, coins e outros itens.</p></div></div><form class="admin-form" method="post" action="/admin/products"><div class="form-row"><label>ID / slug<input name="id" placeholder="vip-diamante"></label><label>Nome<input required name="name" placeholder="VIP Diamante"></label></div><div class="form-row"><label>Categoria<input name="category" placeholder="VIP"></label><label>Preço<input required name="price" inputmode="decimal" placeholder="49,90"></label></div><label>URL da imagem<input name="image" placeholder="https://..."></label><label>Descrição<textarea name="description" rows="3"></textarea></label><div class="checks"><label><input type="checkbox" name="active" checked> Ativo</label><label><input type="checkbox" name="featured"> Destaque</label></div><button class="btn primary">Salvar produto</button></form>
    <div class="product-admin-grid"><% data.products.forEach(p => { %><div class="product-admin-card"><img src="<%= p.image %>"><div><b><%= p.name %></b><span><%= p.category %> • R$ <%= p.price.toFixed(2).replace('.', ',') %></span></div><form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Excluir este produto?')"><button class="danger">Excluir</button></form></div><% }) %></div></section>

    <section id="configuracoes" class="admin-section"><h2>Configurações da loja</h2><form class="admin-form" method="post" action="/admin/settings"><label>Título principal<input name="heroTitle" value="<%= data.settings.heroTitle %>"></label><label>Subtítulo<textarea name="heroSubtitle" rows="2"><%= data.settings.heroSubtitle %></textarea></label><label>Mensagem de entrega<textarea name="deliveryText" rows="3"><%= data.settings.deliveryText %></textarea></label><label>Cor principal<input type="color" name="accent" value="<%= data.settings.accent %>"></label><button class="btn primary">Salvar configurações</button></form></section>
  </div>
</section>
<%- include('partials/footer') %>
